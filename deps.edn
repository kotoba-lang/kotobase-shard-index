;; A manifest, and nothing else.
;;
;; This library has no dependencies and does not want any — reading blocks in
;; a browser is the point, and every dependency is the first thing in the way
;; (README). It is used through `npm test` / `nbb --classpath src` and by
;; consumers who add `src` to their own source paths, none of which need this
;; file.
;;
;; It exists because tools.deps refuses a `:git/sha` coordinate whose
;; repository has no manifest — `Manifest file not found for
;; io.github.kotoba-lang/kotobase-shard-index`, measured 2026-09-06 when
;; net-kotobase/search-origin tried to take this as a git dep instead of a
;; `.deps/<name>` symlink. The symlink form cannot reach a fleet node, so
;; without this file no gate can run a suite that reads this index.
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       }}
